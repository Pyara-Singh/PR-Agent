PROOFMERGE_ENVIRONMENT=development
PROOFMERGE_DATABASE_URL=sqlite+aiosqlite:///./proofmerge.db
PROOFMERGE_WEB_URL=http://localhost:3000
PROOFMERGE_CORS_ORIGINS=http://localhost:3000

# GitHub App. Demo mode works without these values.
PROOFMERGE_GITHUB_WEBHOOK_SECRET=replace-me
PROOFMERGE_GITHUB_TOKEN=

# local, docker. Local execution is off unless explicitly enabled.
PROOFMERGE_SANDBOX_BACKEND=docker
PROOFMERGE_ALLOW_LOCAL_EXECUTION=false
PROOFMERGE_SANDBOX_IMAGE=python:3.12-slim
PROOFMERGE_SANDBOX_TIMEOUT_SECONDS=300

# deterministic, ollama
PROOFMERGE_LLM_PROVIDER=deterministic
PROOFMERGE_OLLAMA_URL=http://localhost:11434/api/generate
PROOFMERGE_OLLAMA_MODEL=llama3.2:1b

# memory, kafka
PROOFMERGE_QUEUE_BACKEND=memory
PROOFMERGE_KAFKA_BOOTSTRAP_SERVERS=localhost:19092
PROOFMERGE_KAFKA_TOPIC=proofmerge.reviews

# Optional project-goal/ADR index.
PROOFMERGE_QDRANT_URL=
PROOFMERGE_QDRANT_COLLECTION=proofmerge_knowledge

# Optional object storage. Local artifacts are used when blank.
PROOFMERGE_S3_ENDPOINT_URL=
PROOFMERGE_S3_BUCKET=proofmerge-artifacts
PROOFMERGE_S3_ACCESS_KEY=
PROOFMERGE_S3_SECRET_KEY=
