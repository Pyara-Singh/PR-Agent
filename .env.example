PR_AGENT_ENVIRONMENT=development
PR_AGENT_DATABASE_URL=sqlite+aiosqlite:///./pr-agent.db
PR_AGENT_WEB_URL=http://localhost:3000
PR_AGENT_CORS_ORIGINS=http://localhost:3000

# GitHub App. Demo mode works without these values.
PR_AGENT_GITHUB_WEBHOOK_SECRET=replace-me
PR_AGENT_GITHUB_TOKEN=
# Set true only after giving the token permission to create PR issue comments.
PR_AGENT_GITHUB_COMMENTS_ENABLED=false

# Guarded local Coding Agent. It creates only approved local commits; remote pushes are off by default.
PR_AGENT_CODING_AGENT_ENABLED=false
# Comma-separated directories that may contain repositories the Coding Agent can inspect.
PR_AGENT_CODING_ALLOWED_ROOTS=
PR_AGENT_CODING_AUTO_PUSH=false

# local, docker. Local execution is off unless explicitly enabled.
PR_AGENT_SANDBOX_BACKEND=docker
PR_AGENT_ALLOW_LOCAL_EXECUTION=false
PR_AGENT_SANDBOX_IMAGE=gcc:14
PR_AGENT_SANDBOX_TIMEOUT_SECONDS=300

# deterministic, ollama, openai, gemini, grok
PR_AGENT_LLM_PROVIDER=deterministic
PR_AGENT_OPENAI_API_KEY=
PR_AGENT_OPENAI_MODEL=gpt-4o-mini
PR_AGENT_OPENAI_URL=https://api.openai.com/v1/chat/completions
PR_AGENT_GEMINI_API_KEY=
PR_AGENT_GEMINI_MODEL=gemini-2.5-flash
PR_AGENT_GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/models
PR_AGENT_GROK_API_KEY=
PR_AGENT_GROK_MODEL=grok-4.5
PR_AGENT_GROK_URL=https://api.x.ai/v1/chat/completions
PR_AGENT_OLLAMA_URL=http://localhost:11434/api/generate
PR_AGENT_OLLAMA_MODEL=llama3.2:1b

# memory, kafka
PR_AGENT_QUEUE_BACKEND=memory
PR_AGENT_KAFKA_BOOTSTRAP_SERVERS=localhost:19092
PR_AGENT_KAFKA_TOPIC=pr-agent.reviews

# Optional project-goal/ADR index.
PR_AGENT_QDRANT_URL=
PR_AGENT_QDRANT_COLLECTION=pr-agent_knowledge

# Optional object storage. Local artifacts are used when blank.
PR_AGENT_S3_ENDPOINT_URL=
PR_AGENT_S3_BUCKET=pr-agent-artifacts
PR_AGENT_S3_ACCESS_KEY=
PR_AGENT_S3_SECRET_KEY=
